# Copy to .env and fill in. Never commit .env.

# Meta app dashboard -> App settings -> Basic -> App Secret
WA_APP_SECRET=

# You invent this. Any random string. Must match what you type into
# Meta's webhook configuration screen.
WA_VERIFY_TOKEN=

# Display only. The product never converts between currencies.
QR_CURRENCY=AED

# Shown in the dashboard header.
QR_BUSINESS_NAME=Your business

# Hours before an open conversation is flagged overdue. One global default;
# no per-client configuration in v1.
QR_STALE_HOURS=24

# SQLite file. Defaults to quoteradar.db in the repo root.
QR_DB_PATH=
